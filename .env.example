# ===== Servidor MCP =====
MCP_HOST=127.0.0.1
MCP_PORT=7342
MCP_PATH=/mcp
MCP_URL=http://127.0.0.1:7342/mcp

# ===== IA Viewnext =====
# Normalmente será un endpoint compatible con Chat Completions. Pide a tu tutor:
# - URL completa del endpoint
# - API key
# - nombre del modelo
VIEWNEXT_API_URL=https://TU-ENDPOINT-VIEWNEXT/v1/chat/completions
VIEWNEXT_API_KEY=pon_aqui_tu_api_key
VIEWNEXT_MODEL=pon_aqui_el_modelo
VIEWNEXT_TIMEOUT_SECONDS=60

# Deja true mientras no tengas la API real de Viewnext.
MOCK_AI=true

# ===== Gmail OAuth =====
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GMAIL_MAX_RESULTS=10

# Deja true mientras no tengas configurado OAuth de Gmail.
MOCK_GMAIL=true
