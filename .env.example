# Ejemplo para la configuración de variables de entorno para la aplicación MCP
# MCP
MCP_HOST=127.0.0.1
MCP_PORT=7342
MCP_PATH=/mcp
MCP_URL=http://127.0.0.1:7342/mcp

# Modo mock
MOCK_AI=true
MOCK_GMAIL=true

# Viewnext / IA
VIEWNEXT_API_URL=
VIEWNEXT_API_KEY=
VIEWNEXT_MODEL=
VIEWNEXT_TIMEOUT_SECONDS=60

# Headers Viewnext
VIEWNEXT_PROVIDER=AzureOpenAI
VIEWNEXT_ORIGIN=asistente-correo-mcp
VIEWNEXT_ORIGIN_DETAIL=proyecto-becarios-gmail-agent

# Gmail
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GMAIL_MAX_RESULTS=10